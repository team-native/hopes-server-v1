PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=none
GEMINI_API_KEY=
AI_EMBEDDING_BATCH_SIZE=4
# 임베딩은 로컬 실행(DJL + PyTorch). 최초 부팅 시 모델을 내려받아 DJL 캐시에 저장한다.
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-large
AI_EMBEDDING_MODEL_URL=djl://ai.djl.huggingface.pytorch/intfloat/multilingual-e5-large
# DJL 모델·엔진 캐시 위치(선택). 미설정 시 ~/.djl.ai 사용.
# DJL_CACHE_DIR=./data/djl-cache
RATE_LIMIT_MESSAGES_PER_MINUTE=10
RATE_LIMIT_LOGIN_ATTEMPTS_PER_MINUTE=5
RATE_LIMIT_VERIFICATION_REQUESTS_PER_MINUTE=3
RATE_LIMIT_VERIFICATION_ATTEMPTS_PER_MINUTE=5
RATE_LIMIT_AUTH_REQUESTS_PER_IP_PER_MINUTE=60
TOKEN_SECRET=replace-with-at-least-64-random-characters
TOKEN_VALIDITY_HOURS=168
VERIFICATION_TTL_MINUTES=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=team.native.official@gmail.com
MAIL_PASSWORD=
MAIL_FROM=team.native.official@gmail.com
DATABASE_URL=jdbc:mysql://localhost:3306/hopes?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DATABASE_USERNAME=root
DATABASE_PASSWORD=
